# Puerto del servidor (Render lo define automáticamente en producción).
PORT=3000

# Entorno de ejecución.
NODE_ENV=development

# Secreto usado para firmar la cookie de sesión. Cambiar en producción.
SESSION_SECRET=cambiar-en-produccion

# Directorio alternativo para los JSON de persistencia.
# Si se omite, se usa backend/src/data/.
CINESTOCK_DATA_DIR=
